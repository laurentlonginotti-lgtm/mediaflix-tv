<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediaflixTV" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0a0a0a</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="PinButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:backgroundTint">#1e1e1e</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
